import java.io.*;
import java.nio.file.*;
import java.time.LocalDate;
import java.util.*;
import java.util.stream.*;

/**
 * AthleteIQ: Athlete Performance Tracking and Selection System (CP-088).
 * Requires Java 17+. Run:  java AthleteIQ.java          (menu)
 *                          java AthleteIQ.java --demo   (load sample data)
 * Data is saved to athleteiq.txt. No external libraries.
 */
public class AthleteIQ {

    // ---------- model ----------
    record Athlete(int id, String name, String sport, String ageGroup) {}
    record Result(int athleteId, String test, double value, LocalDate date) {}
    /** A test type: unit and whether a lower value is better (sprint time) or higher (jump distance). */
    record TestType(String unit, boolean lowerIsBetter) {}

    static final Map<String, TestType> TESTS = new LinkedHashMap<>();
    static {
        TESTS.put("sprint100m", new TestType("s", true));
        TESTS.put("jump", new TestType("m", false));
        TESTS.put("run1500m", new TestType("s", true));
        TESTS.put("pushups", new TestType("reps", false));
    }

    // ---------- state ----------
    static final Map<Integer, Athlete> athletes = new LinkedHashMap<>();
    static final List<Result> results = new ArrayList<>();
    static final Map<String, Map<String, Double>> standards = new HashMap<>(); // ageGroup -> test -> minimum
    static int nextId = 1;
    static final Path DB = Path.of("athleteiq.txt");

    // ---------- Feature 1: register ----------
    static int register(String name, String sport, String ageGroup) {
        if (name.isBlank() || sport.isBlank() || ageGroup.isBlank()) throw new IllegalArgumentException("All fields are required");
        int id = nextId++;
        athletes.put(id, new Athlete(id, clean(name), clean(sport), ageGroup.toUpperCase()));
        return id;
    }

    // ---------- Feature 2: record results ----------
    static void record(int athleteId, String test, double value, LocalDate date) {
        if (!athletes.containsKey(athleteId)) throw new IllegalArgumentException("Unknown athlete id");
        if (!TESTS.containsKey(test)) throw new IllegalArgumentException("Unknown test. Choose from " + TESTS.keySet());
        if (value <= 0) throw new IllegalArgumentException("Value must be positive");
        results.add(new Result(athleteId, test, value, date));
    }

    static List<Result> history(int athleteId, String test) {
        return results.stream()
                .filter(r -> r.athleteId() == athleteId && r.test().equals(test))
                .sorted(Comparator.comparing(Result::date))
                .collect(Collectors.toList());
    }

    // ---------- Feature 3: improvement % between first and latest test ----------
    /** Positive = better. Accounts for lower-is-better tests. Empty if fewer than 2 results. */
    static OptionalDouble improvement(int athleteId, String test) {
        List<Result> h = history(athleteId, test);
        if (h.size() < 2) return OptionalDouble.empty();
        double first = h.get(0).value(), last = h.get(h.size() - 1).value();
        double pct = TESTS.get(test).lowerIsBetter() ? (first - last) / first * 100 : (last - first) / first * 100;
        return OptionalDouble.of(pct);
    }

    // ---------- Feature 4: rank per test within an age group (latest result; ties share rank) ----------
    record Ranked(int rank, Athlete athlete, double value) {}

    static List<Ranked> ranking(String test, String ageGroup) {
        boolean low = TESTS.get(test).lowerIsBetter();
        List<Map.Entry<Athlete, Double>> rows = new ArrayList<>();
        for (Athlete a : athletes.values()) {
            if (!a.ageGroup().equals(ageGroup)) continue;
            List<Result> h = history(a.id(), test);
            if (!h.isEmpty()) rows.add(Map.entry(a, h.get(h.size() - 1).value()));
        }
        rows.sort(low ? Map.Entry.comparingByValue() : Map.Entry.<Athlete, Double>comparingByValue().reversed());
        List<Ranked> out = new ArrayList<>();
        double prev = Double.NaN; int rank = 0, pos = 0;
        for (var e : rows) {
            pos++;
            if (e.getValue() != prev) rank = pos;
            out.add(new Ranked(rank, e.getKey(), e.getValue()));
            prev = e.getValue();
        }
        return out;
    }

    // ---------- Feature 5: selection list using minimum standards ----------
    static boolean meets(String test, double value, double minimum) {
        return TESTS.get(test).lowerIsBetter() ? value <= minimum : value >= minimum;
    }

    /** Selected = latest result meets EVERY standard set for the age group. Null if no standards exist. */
    static Map<Athlete, List<String>> selection(String ageGroup) {
        Map<String, Double> std = standards.get(ageGroup);
        if (std == null || std.isEmpty()) return null;
        Map<Athlete, List<String>> selected = new LinkedHashMap<>();
        for (Athlete a : athletes.values()) {
            if (!a.ageGroup().equals(ageGroup)) continue;
            boolean ok = true;
            List<String> detail = new ArrayList<>();
            for (var s : std.entrySet()) {
                List<Result> h = history(a.id(), s.getKey());
                if (h.isEmpty() || !meets(s.getKey(), h.get(h.size() - 1).value(), s.getValue())) {
                    ok = false; detail.add(s.getKey() + ": fail/missing");
                } else detail.add(s.getKey() + ": " + h.get(h.size() - 1).value() + " ok");
            }
            if (ok) selected.put(a, detail);
        }
        return selected;
    }

    // ---------- Stretch: flag two consecutive drops (last 3 results) ----------
    static List<String> declining() {
        List<String> flags = new ArrayList<>();
        for (Athlete a : athletes.values())
            for (var t : TESTS.entrySet()) {
                List<Double> v = history(a.id(), t.getKey()).stream().map(Result::value).collect(Collectors.toList());
                if (v.size() < 3) continue;
                v = v.subList(v.size() - 3, v.size());
                boolean low = t.getValue().lowerIsBetter();
                boolean drop1 = low ? v.get(1) > v.get(0) : v.get(1) < v.get(0);
                boolean drop2 = low ? v.get(2) > v.get(1) : v.get(2) < v.get(1);
                if (drop1 && drop2) flags.add(a.name() + ": " + t.getKey() + " worsened twice in a row " + v);
            }
        return flags;
    }

    // ---------- Stretch: text chart ----------
    static String textChart(int athleteId, String test) {
        List<Result> h = history(athleteId, test);
        if (h.isEmpty()) return "No results.";
        double top = h.stream().mapToDouble(Result::value).max().getAsDouble();
        TestType t = TESTS.get(test);
        StringBuilder sb = new StringBuilder(athletes.get(athleteId).name() + " - " + test + " (" + t.unit()
                + ", " + (t.lowerIsBetter() ? "lower" : "higher") + " is better)\n");
        for (Result r : h)
            sb.append(r.date()).append(" | ").append("#".repeat(Math.max(1, (int) Math.round(r.value() / top * 40))))
              .append(' ').append(r.value()).append('\n');
        return sb.toString();
    }

    // ---------- persistence ----------
    static String clean(String s) { return s.trim().replace("|", " "); }

    static void save() throws IOException {
        List<String> lines = new ArrayList<>();
        lines.add("N|" + nextId);
        athletes.values().forEach(a -> lines.add("A|" + a.id() + "|" + a.name() + "|" + a.sport() + "|" + a.ageGroup()));
        results.forEach(r -> lines.add("R|" + r.athleteId() + "|" + r.test() + "|" + r.value() + "|" + r.date()));
        standards.forEach((g, m) -> m.forEach((t, v) -> lines.add("S|" + g + "|" + t + "|" + v)));
        Files.write(DB, lines);
    }

    static void load() throws IOException {
        if (!Files.exists(DB)) return;
        for (String line : Files.readAllLines(DB)) {
            String[] p = line.split("\\|");
            switch (p[0]) {
                case "N" -> nextId = Integer.parseInt(p[1]);
                case "A" -> athletes.put(Integer.parseInt(p[1]), new Athlete(Integer.parseInt(p[1]), p[2], p[3], p[4]));
                case "R" -> results.add(new Result(Integer.parseInt(p[1]), p[2], Double.parseDouble(p[3]), LocalDate.parse(p[4])));
                case "S" -> standards.computeIfAbsent(p[1], k -> new HashMap<>()).put(p[2], Double.parseDouble(p[3]));
                default -> { }
            }
        }
    }

    // ---------- demo data ----------
    static void demo() {
        athletes.clear(); results.clear(); standards.clear(); nextId = 1;
        String[][] people = {{"Aarav", "U16"}, {"Diya", "U16"}, {"Kabir", "U16"}, {"Meera", "U18"}, {"Rohan", "U18"}};
        for (String[] p : people) register(p[0], "Athletics", p[1]);
        String[] dates = {"2026-06-01", "2026-08-01", "2026-10-01"};
        double[][] sprint = {{13.2, 13.0, 12.8}, {12.4, 12.2, 12.1}, {12.5, 12.9, 13.4}, {12.9, 12.7, 12.6}, {13.1, 12.9, 12.9}};
        double[][] jump = {{4.9, 5.0, 5.2}, {4.7, 4.8, 4.9}, {5.3, 5.0, 4.6}, {5.0, 5.1, 5.3}, {4.8, 4.9, 4.95}};
        for (int i = 0; i < 5; i++)
            for (int k = 0; k < 3; k++) {
                record(i + 1, "sprint100m", sprint[i][k], LocalDate.parse(dates[k]));
                record(i + 1, "jump", jump[i][k], LocalDate.parse(dates[k]));
            }
        standards.put("U16", new HashMap<>(Map.of("sprint100m", 13.0, "jump", 4.8)));
        standards.put("U18", new HashMap<>(Map.of("sprint100m", 12.8, "jump", 5.0)));
    }

    // ---------- CLI ----------
    static final Scanner in = new Scanner(System.in);
    static String ask(String prompt) { System.out.print(prompt); return in.hasNextLine() ? in.nextLine().trim() : "0"; }

    static void menu() throws IOException {
        String[] items = {"Register athlete", "Record test result", "Improvement report", "Rank in age group",
                "Set minimum standard", "Selection list", "Flag declining athletes", "Progress chart", "Show athletes"};
        while (true) {
            System.out.println("\n=== AthleteIQ ===");
            for (int i = 0; i < items.length; i++) System.out.println(" " + (i + 1) + ". " + items[i]);
            System.out.println(" 0. Exit");
            String c = ask("> ");
            try {
                switch (c) {
                    case "0" -> { return; }
                    case "1" -> System.out.println("Registered with id " + register(ask("Name: "), ask("Sport: "), ask("Age group (e.g. U16): ")));
                    case "2" -> {
                        System.out.println("Tests: " + TESTS.keySet());
                        int id = Integer.parseInt(ask("Athlete id: "));
                        String test = ask("Test: ");
                        double v = Double.parseDouble(ask("Value: "));
                        String d = ask("Date YYYY-MM-DD (blank=today): ");
                        record(id, test, v, d.isEmpty() ? LocalDate.now() : LocalDate.parse(d));
                        System.out.println("Saved.");
                    }
                    case "3" -> athletes.values().forEach(a -> TESTS.keySet().forEach(t ->
                            improvement(a.id(), t).ifPresent(p -> System.out.printf("%-10s %-11s %+.2f%%%n", a.name(), t, p))));
                    case "4" -> {
                        String t = ask("Test: "), g = ask("Age group: ").toUpperCase();
                        if (!TESTS.containsKey(t)) throw new IllegalArgumentException("Unknown test");
                        ranking(t, g).forEach(r -> System.out.printf("#%d %-10s %s %s%n", r.rank(), r.athlete().name(), r.value(), TESTS.get(t).unit()));
                    }
                    case "5" -> {
                        String g = ask("Age group: ").toUpperCase(), t = ask("Test: ");
                        if (!TESTS.containsKey(t)) throw new IllegalArgumentException("Unknown test");
                        standards.computeIfAbsent(g, k -> new HashMap<>()).put(t, Double.parseDouble(ask("Minimum standard value: ")));
                        System.out.println("Set.");
                    }
                    case "6" -> {
                        String g = ask("Age group: ").toUpperCase();
                        var s = selection(g);
                        if (s == null) System.out.println("No standards set for " + g);
                        else {
                            System.out.println("Selected (" + s.size() + "):");
                            s.forEach((a, det) -> System.out.println(" - " + a.name() + " (" + a.sport() + "): " + String.join("; ", det)));
                        }
                    }
                    case "7" -> { var f = declining(); if (f.isEmpty()) System.out.println("No declining athletes."); else f.forEach(x -> System.out.println("FLAG " + x)); }
                    case "8" -> {
                        int id = Integer.parseInt(ask("Athlete id: "));
                        String t = ask("Test: ");
                        if (!athletes.containsKey(id) || !TESTS.containsKey(t)) throw new IllegalArgumentException("Unknown athlete or test");
                        System.out.print(textChart(id, t));
                    }
                    case "9" -> athletes.values().forEach(a -> System.out.println(a.id() + " " + a.name() + " " + a.sport() + " " + a.ageGroup()));
                    default -> System.out.println("Pick 0-9.");
                }
                save();
            } catch (IllegalArgumentException | java.time.format.DateTimeParseException e) {
                System.out.println("Error: " + e.getMessage());
            }
        }
    }

    public static void main(String[] args) throws IOException {
        load();
        if (Arrays.asList(args).contains("--demo")) { demo(); save(); System.out.println("Demo data loaded."); }
        menu();
    }
}
